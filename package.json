{
  "name": "dsh-session-search",
  "version": "0.1.0",
  "description": "跨会话中文全文搜索：Ctrl+P 浮窗，任意子串命中，定位到会话与消息。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "search"
  ],
  "license": "MIT",
  "author": "Changye Pan",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
