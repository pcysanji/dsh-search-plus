{
  "name": "dsh-search-plus",
  "version": "0.1.0",
  "description": "DSH 跨会话全文搜索浮窗：Ctrl+F 搜全部历史对话，任意中文子串命中，点结果定位到那句话。Cross-session full-text search overlay for DeepSeek Harness.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "search",
    "full-text-search",
    "session-search",
    "cordis-plugin"
  ],
  "license": "MIT",
  "author": "Changye Pan <pcysanji@163.com>",
  "homepage": "https://github.com/pcysanji/dsh-search-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcysanji/dsh-search-plus.git"
  },
  "bugs": {
    "url": "https://github.com/pcysanji/dsh-search-plus/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/screenshot-light.png",
    "docs/screenshot-dark.png"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
